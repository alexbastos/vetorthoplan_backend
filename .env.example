APP_ENV=local
IDENTITY_MODE=local
# Necessários quando IDENTITY_MODE=jwt (issuer exato e endpoint JWKS da authentication_api).
# JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=vetorthoplan-api
# JWKS_URL=https://auth.example.com/.well-known/jwks.json
JWKS_CACHE_SECONDS=300
JWKS_TIMEOUT_SECONDS=3
JWT_CLOCK_SKEW_SECONDS=30
LOCAL_TENANT_ID=00000000-0000-4000-8000-000000000001
LOCAL_ACTOR_ID=00000000-0000-4000-8000-000000000002
DATABASE_URL=postgresql+asyncpg://vetorthoplan:vetorthoplan@localhost:5432/vetorthoplan
STORAGE_BUCKET=vetorthoplan-uploads-local
STORAGE_REGION=us-east-1
# O script scripts/setup_local_object_storage.sh configura RustFS S3, credenciais locais
# e STORAGE_ENDPOINT_URL sem exigir AWS.
# STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
# Defina quando o navegador usa um endpoint diferente do backend.
# URLs pré-assinadas usam este host sem reescrever a assinatura.
# STORAGE_PUBLIC_ENDPOINT_URL=https://storage.example.com
UPLOAD_URL_EXPIRES_SECONDS=300
PREVIEW_URL_EXPIRES_SECONDS=300
STORAGE_CLOCK_SKEW_SECONDS=5
MAX_UPLOADS_PER_CASE=20
WORKER_POLL_SECONDS=1
# Catálogo interno: token administrativo aleatório com pelo menos 32 caracteres.
# O conversor é um adaptador interno. O formato de origem e o formato canônico
# editável podem ser escolhidos separadamente sem alterar a API do catálogo.
# IMPLANT_CATALOG_ADMIN_TOKEN=
# IMPLANT_CATALOG_CONVERSION_SERVICE_URL=http://implant-converter:8080/v1/convert
# IMPLANT_CATALOG_CONVERSION_SERVICE_TOKEN=
# IMPLANT_CATALOG_CONVERSION_TIMEOUT_SECONDS=120
# Tabela oficial é seedada pela migration 20261026_0018; configure estes valores apenas para substituí-la.
# Para filtrar, as linhas precisam incluir tpa_degrees e/ou blade_diameter_mm.
# Os dados devem vir da tabela aprovada pelo parceiro clínico.
# A tabela oficial BioMedtrix/VOI é instalada pela migration 20261026_0018.
# Use as variáveis abaixo somente para substituir a tabela ativa por outra versão homologada.
# As três variáveis devem ser preenchidas em conjunto; o JSON deve ser um array de linhas.
# TPLO_ROTATION_TABLE_VERSION=parceiro-2026-v1
# TPLO_ROTATION_TABLE_SOURCE=Protocolo clínico aprovado pelo parceiro
# TPLO_ROTATION_TABLE_JSON=<JSON array da tabela aprovada>
# TPLO_ROTATION_TABLE_TARGET_SLOPE_DEGREES=5
# Protocolo clínico versionado: medidas extras por distância (2 marcos) ou ângulo (3 marcos).
# A tolerância é o erro absoluto máximo em relação a reference_values informado na revisão.
# Até a homologação pelo parceiro, mantenha desconfigurado.
# TPLO_CLINICAL_PROTOCOL_JSON={"version":"clinico-v1","source":"Protocolo homologado pelo parceiro","tpa_max_absolute_error_degrees":2.0,"measurements":[{"id":"CRANIAL_CORTEX_LENGTH","label":"Comprimento do córtex cranial","kind":"DISTANCE","landmarks":["cortex_start","cortex_end"],"unit":"mm","max_absolute_error":1.0}]}
