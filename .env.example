APP_ENV=local
IDENTITY_MODE=local
LOCAL_TENANT_ID=00000000-0000-4000-8000-000000000001
LOCAL_ACTOR_ID=00000000-0000-4000-8000-000000000002
DATABASE_URL=postgresql+asyncpg://vetorthoplan:vetorthoplan@localhost:5432/vetorthoplan
STORAGE_BUCKET=vetorthoplan-uploads-local
STORAGE_REGION=us-east-1
# O script scripts/setup_local_object_storage.sh configura MinIO, credenciais locais
# e STORAGE_ENDPOINT_URL sem exigir AWS.
# STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
UPLOAD_URL_EXPIRES_SECONDS=300
PREVIEW_URL_EXPIRES_SECONDS=300
MAX_UPLOADS_PER_CASE=20
WORKER_POLL_SECONDS=1
